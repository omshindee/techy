# Techy settings. Locally: copy to .env (used by docker-compose).
# In the cloud: set the same names as environment variables on your backend host.
# See DEPLOYMENT.md for the Cloudflare Pages setup.

# --- Database. Managed Postgres usually needs SSL, e.g.
# DB_URL=jdbc:postgresql://HOST:5432/DBNAME?sslmode=require   (docker-compose sets DB_URL itself)
DB_USERNAME=devsocial
DB_PASSWORD=change-me
DB_POOL_SIZE=5

# --- REQUIRED, 32+ characters. The backend refuses to start without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- Cloudflare Pages proxy. Same long random value here (backend) and in Pages (secret PROXY_SECRET).
# When set, the API only accepts requests that come through your Pages site. Leave empty locally.
# Generate one with: openssl rand -hex 32
PROXY_SECRET=

# Public address of the site (used in email links), e.g. https://techy.pages.dev or your custom domain.
APP_BASE_URL=http://localhost:3000
# Only needed if a browser calls the API directly from another site (not needed with the Pages proxy).
# Wildcards allowed, e.g. https://*.techy.pages.dev
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Photo storage.
#   local: files in STORAGE_DIR (needs a persistent disk; fine for docker-compose and VPSs)
#   s3:    S3-compatible bucket. Recommended in the cloud: Cloudflare R2, e.g.
#          S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  S3_REGION=auto
STORAGE_TYPE=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email. Needed for email confirmation and password reset in production.
# Any SMTP provider works (Resend, Brevo, Postmark, Mailgun, Amazon SES, Gmail app password...).
# Leave SMTP_HOST empty locally: emails are then printed in the backend log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Techy <no-reply@example.com>
# New accounts must confirm their email before posting, commenting, liking, following or reporting.
REQUIRE_EMAIL_VERIFICATION=true

# --- Captcha on sign-up and password reset (free): Cloudflare dashboard → Turnstile.
# Leave empty to turn it off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Moderators: comma-separated emails. They get moderator rights once that email is confirmed.
ADMIN_EMAILS=
